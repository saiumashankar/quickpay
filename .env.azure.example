# Copy to .env on the Azure VM; generate new random values for every deployment.
AUTH_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
JWT_SECRET=
INTERNAL_API_TOKEN=

# Use SMTP credentials from a real SMTP relay (for example, Azure Communication Services).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=
