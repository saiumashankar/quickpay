# Normalise line endings so the same file does not show as modified on
# Windows and Linux checkouts.
* text=auto

*.java text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.properties text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Windows scripts must keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
